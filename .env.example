# Backend adapter: memory | supabase | rest. Not read yet; only the Supabase backend exists.
VITE_BACKEND=supabase

# Supabase project URL (https://<project-ref>.supabase.co) and anon key, from Project Settings → API.
# The anon key ships to every browser; access control lives in the backend, not in keeping it secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
