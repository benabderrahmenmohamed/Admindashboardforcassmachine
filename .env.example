# Backend adapter: memory | supabase (default) | rest.
VITE_BACKEND=supabase

# Supabase project URL (https://<project-ref>.supabase.co) and anon key, from Project Settings → API.
# The anon key ships to every browser; access control lives in the backend, not in keeping it secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# With VITE_BACKEND=rest: where the API of contracts/openapi.yaml is served - the Symfony server in
# api/ answers it, at http://127.0.0.1:8000 when it is run with `php -S 127.0.0.1:8000 -t public`.
VITE_API_BASE_URL=
